generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Juz {
  id        Int      @id
  number    Int      @unique
  title     String
  createdAt DateTime @default(now())
  pages     Page[]
}

model Page {
  id            Int      @id @default(autoincrement())
  juzId         Int
  unitNumber    Int
  mushafPage    Int
  label         String
  surahLabel    String?
  verseRange    String?
  wordCount     Int      @default(0)
  coreWordCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  juz          Juz              @relation(fields: [juzId], references: [id], onDelete: Cascade)
  occurrences  WordOccurrence[]
  pageProgress PageProgress[]
  sentenceSegments SentenceSegment[]

  @@unique([juzId, unitNumber])
  @@unique([juzId, mushafPage])
}

model Lexeme {
  id                  Int      @id @default(autoincrement())
  key                 String   @unique
  arabicDisplay       String
  lemma               String?
  lemmaCorpus         String?
  root                String?
  rootCorpus          String?
  partOfSpeech        String?
  englishPrimary      String?
  englishAlternatives String   @default("[]")
  indonesian          String?
  courseStatus        String   @default("CORE")
  reviewStatus        String   @default("PROVISIONAL")
  difficulty          Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  occurrences WordOccurrence[]
  progresses  WordProgress[]
  attempts    Attempt[]

  @@index([lemma])
  @@index([root])
  @@index([courseStatus])
  @@index([reviewStatus])
}

model WordOccurrence {
  id               Int      @id @default(autoincrement())
  pageId           Int
  lexemeId         Int
  location         String   @unique
  verseKey         String
  surah            Int
  ayah             Int
  wordPosition     Int
  arabic           String
  uthmani          String?
  normalizedArabic String
  transliteration  String?
  sourceEnglish    String?
  sourceIndonesian String?
  contextArabic    String?
  audioUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lexeme   Lexeme    @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  attempts Attempt[]
  sentenceWords SentenceSegmentWord[]

  @@index([pageId])
  @@index([lexemeId])
  @@index([verseKey])
  @@index([surah, ayah])
}

model Learner {
  id               String    @id
  userId           String?   @unique
  displayName      String?
  isAnonymous      Boolean   @default(true)
  xp               Int       @default(0)
  streakDays       Int       @default(0)
  tafsirAttempts   Int       @default(0)
  tafsirSuccessful Int       @default(0)
  lastStudyDate    DateTime?
  lastAllWordsReviewDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wordProgress     WordProgress[]
  pageProgress     PageProgress[]
  attempts         Attempt[]
  studySessions    StudySession[]
  tafsirNotes      TafsirNote[]
  tafsirVocabulary TafsirVocabulary[]
  tafsirPassages   TafsirPassage[]
  sentenceProgress SentenceProgress[]
  sentenceSessions SentenceQuizSession[]
  sentenceAttempts SentenceQuizAttempt[]
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verse {
  id          Int      @id @default(autoincrement())
  surah       Int
  ayahNumber  Int
  arabicText  String
  translation String?
  theme       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes      TafsirNote[]
  vocabulary TafsirVocabulary[]
  passageMembers TafsirPassageVerse[]
  sentenceSegments SentenceSegment[]

  @@unique([surah, ayahNumber])
  @@index([surah, ayahNumber])
}

model TafsirNote {
  id        Int      @id @default(autoincrement())
  verseId   Int
  learnerId String
  category  String
  content   Json
  reference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verse   Verse   @relation(fields: [verseId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, verseId, category])
  @@index([learnerId, updatedAt])
  @@index([verseId])
}

model TafsirVocabulary {
  id              Int      @id @default(autoincrement())
  verseId         Int
  learnerId       String
  arabicWord      String
  transliteration String?
  root            String?
  meaning         String
  explanation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  verse   Verse   @relation(fields: [verseId], references: [id], onDelete: Cascade)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, verseId])
  @@index([verseId])
}

model TafsirPassage {
  id        String    @id @default(cuid())
  learnerId String
  title     String
  theme     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  learner    Learner               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  verses     TafsirPassageVerse[]
  notes      TafsirPassageNote[]
  vocabulary TafsirPassageVocabulary[]

  @@index([learnerId, updatedAt])
}

model TafsirPassageVerse {
  id        Int      @id @default(autoincrement())
  passageId String
  verseId   Int
  position  Int
  createdAt DateTime @default(now())

  passage TafsirPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  verse   Verse         @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@unique([passageId, verseId])
  @@unique([passageId, position])
  @@index([verseId])
}

model TafsirPassageNote {
  id        Int      @id @default(autoincrement())
  passageId String
  category  String
  content   Json
  reference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passage TafsirPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([passageId, category])
  @@index([passageId, updatedAt])
}

model TafsirPassageVocabulary {
  id              Int      @id @default(autoincrement())
  passageId       String
  arabicWord      String
  transliteration String?
  root            String?
  meaning         String
  explanation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  passage TafsirPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@index([passageId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?  @map("name")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  learner  Learner?
  sessions AuthSession[]
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("Session")
}

model AuthRateLimit {
  id           String   @id @default(cuid())
  key          String   @unique
  windowStart  DateTime
  attemptCount Int      @default(0)
  updatedAt    DateTime

  @@index([windowStart])
}

model WordProgress {
  id                Int       @id @default(autoincrement())
  learnerId         String
  lexemeId          Int
  masteryLevel      String    @default("NEW")
  correctCount      Int       @default(0)
  wrongCount        Int       @default(0)
  streakCorrect     Int       @default(0)
  easeFactor        Float     @default(2.5)
  intervalDays      Int       @default(0)
  lastReviewedAt    DateTime?
  nextReviewAt      DateTime?
  averageResponseMs Int?
  weakReviewRequired Int     @default(0)
  weakReviewPassed   Int     @default(0)

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lexemeId])
  @@index([learnerId, nextReviewAt])
}

model PageProgress {
  id               Int       @id @default(autoincrement())
  learnerId        String
  pageId           Int
  masteryStars     Int       @default(0)
  completed        Boolean   @default(false)
  completedLessons Int       @default(0)
  reviewedLessons  Int       @default(0)
  lessonCount      Int       @default(1)
  bestAccuracy     Float     @default(0)
  sessions         Int       @default(0)
  lastStudiedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([learnerId, pageId])
  @@index([learnerId, completed])
}

model Attempt {
  id             Int      @id @default(autoincrement())
  learnerId      String
  lexemeId       Int
  occurrenceId   Int?
  exerciseType   String
  correct        Boolean
  response       String?
  responseTimeMs Int?
  xpAwarded      Int      @default(0)
  clientAttemptId String? @unique
  studySessionId String?
  questionKey    String?
  createdAt      DateTime @default(now())

  learner    Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lexeme     Lexeme          @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  occurrence WordOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  studySession StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  @@index([learnerId, createdAt])
  @@index([lexemeId, createdAt])
  @@index([studySessionId])
}

model StudySession {
  id          String   @id @default(cuid())
  learnerId   String
  kind        String
  unitNumber  Int?
  lesson      Int?
  questionPlan Json
  status      String   @default("ACTIVE")
  result      Json?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  learner  Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([learnerId, status, updatedAt])
}

model SentenceSegment {
  id                    String   @id @default(cuid())
  pageId                Int
  verseId               Int
  segmentOrder          Int
  verseOrder            Int      @default(1)
  startWordPosition     Int?
  endWordPosition       Int?
  arabicText            String
  englishTranslation    String?
  indonesianTranslation String?
  translationSource     String?
  sourceUrl             String?
  contextNote           String?
  explanation           String?
  acceptedAnswers       Json     @default("[]")
  audioUrl              String?
  audioVerified         Boolean  @default(false)
  curationStatus        String   @default("PENDING")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  page       Page                  @relation(fields: [pageId], references: [id], onDelete: Restrict)
  verse      Verse                 @relation(fields: [verseId], references: [id], onDelete: Restrict)
  words      SentenceSegmentWord[]
  progresses SentenceProgress[]
  attempts   SentenceQuizAttempt[]

  @@unique([pageId, verseId, verseOrder])
  @@unique([pageId, segmentOrder])
  @@index([curationStatus, pageId])
}

model SentenceSegmentWord {
  segmentId    String
  occurrenceId Int
  segment      SentenceSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  occurrence   WordOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  @@id([segmentId, occurrenceId])
  @@index([occurrenceId])
}

model SentenceProgress {
  id              Int       @id @default(autoincrement())
  learnerId       String
  segmentId       String
  correctCount    Int       @default(0)
  wrongCount      Int       @default(0)
  streakCorrect   Int       @default(0)
  masteryLevel    String    @default("NEW")
  intervalDays    Int       @default(0)
  easeFactor      Float     @default(2.5)
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime?
  completedAt     DateTime?
  learner Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  segment SentenceSegment @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  @@unique([learnerId, segmentId])
  @@index([learnerId, nextReviewAt])
}

model SentenceQuizSession {
  id            String   @id @default(cuid())
  learnerId     String
  requestId     String   @unique
  mode          String
  questionPlan  Json
  status        String   @default("ACTIVE")
  result        Json?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt
  learner  Learner               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  attempts SentenceQuizAttempt[]
  @@index([learnerId, status, updatedAt])
}

model SentenceQuizAttempt {
  id             String   @id
  learnerId      String
  sessionId      String
  segmentId      String
  questionKey    String
  response       String
  correct        Boolean
  responseTimeMs Int
  xpAwarded      Int      @default(0)
  createdAt      DateTime @default(now())
  learner Learner             @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  session SentenceQuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  segment SentenceSegment     @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  @@index([sessionId, createdAt])
  @@index([learnerId, segmentId, createdAt])
}
