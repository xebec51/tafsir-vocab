generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Juz {
  id        Int      @id
  number    Int      @unique
  title     String
  createdAt DateTime @default(now())
  pages     Page[]
}

model Page {
  id            Int      @id @default(autoincrement())
  juzId         Int
  unitNumber    Int
  mushafPage    Int
  label         String
  surahLabel    String?
  verseRange    String?
  wordCount     Int      @default(0)
  coreWordCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  juz          Juz            @relation(fields: [juzId], references: [id], onDelete: Cascade)
  occurrences  WordOccurrence[]
  pageProgress PageProgress[]

  @@unique([juzId, unitNumber])
  @@unique([juzId, mushafPage])
}

model Lexeme {
  id                  Int      @id @default(autoincrement())
  key                 String   @unique
  arabicDisplay       String
  lemma               String?
  lemmaCorpus         String?
  root                String?
  rootCorpus          String?
  partOfSpeech        String?
  englishPrimary      String?
  englishAlternatives String   @default("[]")
  indonesian          String?
  courseStatus        String   @default("CORE")
  reviewStatus        String   @default("PROVISIONAL")
  difficulty          Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  occurrences WordOccurrence[]
  progresses  WordProgress[]
  attempts    Attempt[]

  @@index([lemma])
  @@index([root])
  @@index([courseStatus])
  @@index([reviewStatus])
}

model WordOccurrence {
  id               Int      @id @default(autoincrement())
  pageId           Int
  lexemeId         Int
  location         String   @unique
  verseKey         String
  surah            Int
  ayah             Int
  wordPosition     Int
  arabic           String
  uthmani          String?
  normalizedArabic String
  transliteration  String?
  sourceEnglish    String?
  sourceIndonesian String?
  contextArabic    String?
  audioUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lexeme   Lexeme    @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([pageId])
  @@index([lexemeId])
  @@index([verseKey])
  @@index([surah, ayah])
}

model Learner {
  id            String    @id
  userId        String?   @unique
  displayName   String?
  isAnonymous   Boolean   @default(true)
  xp            Int       @default(0)
  streakDays    Int       @default(0)
  tafsirAttempts Int      @default(0)
  tafsirSuccessful Int    @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wordProgress WordProgress[]
  pageProgress PageProgress[]
  attempts     Attempt[]
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  displayName  String?       @map("name")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  learner      Learner?
  sessions     AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("Session")
}

model AuthRateLimit {
  id           String   @id @default(cuid())
  key          String   @unique
  windowStart  DateTime
  attemptCount Int      @default(0)
  updatedAt    DateTime

  @@index([windowStart])
}

model WordProgress {
  id                Int      @id @default(autoincrement())
  learnerId         String
  lexemeId          Int
  masteryLevel      String   @default("NEW")
  correctCount      Int      @default(0)
  wrongCount        Int      @default(0)
  streakCorrect     Int      @default(0)
  easeFactor        Float    @default(2.5)
  intervalDays      Int      @default(0)
  lastReviewedAt    DateTime?
  nextReviewAt      DateTime?
  averageResponseMs Int?

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lexeme  Lexeme  @relation(fields: [lexemeId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lexemeId])
  @@index([learnerId, nextReviewAt])
}

model PageProgress {
  id            Int      @id @default(autoincrement())
  learnerId     String
  pageId        Int
  masteryStars  Int      @default(0)
  completed     Boolean  @default(false)
  completedLessons Int   @default(0)
  lessonCount    Int      @default(1)
  bestAccuracy  Float    @default(0)
  sessions      Int      @default(0)
  lastStudiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([learnerId, pageId])
  @@index([learnerId, completed])
}

model Attempt {
  id             Int      @id @default(autoincrement())
  learnerId      String
  lexemeId       Int
  occurrenceId   Int?
  exerciseType   String
  correct        Boolean
  response       String?
  responseTimeMs Int?
  xpAwarded      Int      @default(0)
  createdAt      DateTime @default(now())

  learner    Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lexeme     Lexeme         @relation(fields: [lexemeId], references: [id], onDelete: Cascade)
  occurrence WordOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@index([learnerId, createdAt])
  @@index([lexemeId, createdAt])
}
