{
  "name": "tafsir-vocab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/with-env.mjs prisma generate && next build",
    "start": "next start",
    "lint": "node scripts/with-env.mjs prisma generate && tsc --noEmit",
    "db:generate": "node scripts/with-env.mjs prisma generate",
    "db:seed": "node scripts/with-env.mjs tsx prisma/seed.ts",
    "data:import:juz14": "node scripts/with-env.mjs tsx scripts/import-juz14.ts",
    "data:enrich:morphology": "node scripts/with-env.mjs tsx scripts/enrich-quranic-corpus.ts",
    "data:stats": "node scripts/with-env.mjs tsx scripts/course-stats.ts",
    "typecheck": "node scripts/with-env.mjs prisma generate && tsc --noEmit",
    "data:curate": "node scripts/with-env.mjs tsx scripts/apply-curation.ts",
    "test:core": "tsx --test tests/core.test.ts",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "db:dev": "node scripts/with-env.mjs prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
